    {
      "parameters": {
        "jsCode": "return $input.all().map(({ json }) => {\n  const parts = String(json.queue ?? '')\n    .split(',')\n    .map(part => part.trim().replace(/\\s+/g, ' '));\n\n  const [rawCity = '', rawUF = '', rawCountry = ''] = parts;\n\n  const city = rawCity\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .trim()\n    .replace(/\\s+/g, ' ')\n    .toLowerCase();\n\n  const requestedUF = rawUF.toUpperCase();\n  const country = rawCountry.toUpperCase();\n\n  const isValidFormat =\n    (parts.length === 2 || (parts.length === 3 && country === 'BR')) &&\n    city.length > 0 &&\n    /^[A-Z]{2}$/.test(requestedUF);\n\n  return {\n    json: {\n      ...json,\n      queue: `${city},${requestedUF},BR`,\n      city,\n      requestedUF,\n      country: 'BR',\n      isValidFormat,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -96
      ],
      "id": "afde9064-5546-45da-82e9-9492f5b315d1",
      "name": "Parse and Validate City Input"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "932abb1c-161c-4d7b-8543-0391445dcc37",
              "leftValue": "={{ $json.isValidFormat }}",
              "rightValue": "",
