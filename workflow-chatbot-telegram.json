      "id": "ca418674-59df-46b9-bf50-2c73a60d3cec",
      "name": "Get City Candidates",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const input = $('Parse and Validate City Input').first().json;\n\nconst stateByUF = {\n  AC: 'Acre',\n  AL: 'Alagoas',\n  AP: 'Amapá',\n  AM: 'Amazonas',\n  BA: 'Bahia',\n  CE: 'Ceará',\n  DF: 'Distrito Federal',\n  ES: 'Espírito Santo',\n  GO: 'Goiás',\n  MA: 'Maranhão',\n  MT: 'Mato Grosso',\n  MS: 'Mato Grosso do Sul',\n  MG: 'Minas Gerais',\n  PA: 'Pará',\n  PB: 'Paraíba',\n  PR: 'Paraná',\n  PE: 'Pernambuco',\n  PI: 'Piauí',\n  RJ: 'Rio de Janeiro',\n  RN: 'Rio Grande do Norte',\n  RS: 'Rio Grande do Sul',\n  RO: 'Rondônia',\n  RR: 'Roraima',\n  SC: 'Santa Catarina',\n  SP: 'São Paulo',\n  SE: 'Sergipe',\n  TO: 'Tocantins',\n};\n\nconst normalize = value =>\n  String(value ?? '')\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .trim()\n    .toLowerCase();\n\nconst candidates = $input.all().flatMap(({ json }) =>\n  Array.isArray(json) ? json : [json]\n);\n\nconst expectedState = stateByUF[input.requestedUF];\n\nconst requestedCity = normalize(input.city);\n\nconst match = candidates.find(candidate =>\n  candidate.country === 'BR' &&\n  normalize(candidate.state) === normalize(expectedState) &&\n  [candidate.name, candidate.local_names?.pt]\n    .some(name => normalize(name) === requestedCity)\n);\n\nreturn [{\n  json: {\n    ...input,\n    isCityStateMatch: Boolean(match),\n    resolvedCity: match?.name ?? null,\n    resolvedState: match?.state ?? null,\n    lat: match?.lat ?? null,\n    lon: match?.lon ?? null,\n  },\n}];"
      },
